{
  "name": "sp-sundial",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
